<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Dealership Security Category -->
    <record id="module_category_dealership" model="ir.module.category">
        <field name="name">Dealership</field>
        <field name="sequence">10</field>
    </record>

    <!-- Financing Privilege -->
    <record id="res_groups_privilege_financing" model="res.groups.privilege">
        <field name="name">Financing</field>
        <field name="category_id" ref="module_category_dealership"/>
    </record>

    <!-- Financing User -->
    <record id="group_financing_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_dealership"/>
        <field name="privilege_id" ref="res_groups_privilege_financing"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
    </record>

    <!-- Financing Admin -->
    <record id="group_financing_admin" model="res.groups">
        <field name="name">Admin</field>
        <field name="category_id" ref="module_category_dealership"/>
        <field name="privilege_id" ref="res_groups_privilege_financing"/>
        <field name="implied_ids" eval="[Command.link(ref('group_financing_user'))]"/>
    </record>

</odoo>