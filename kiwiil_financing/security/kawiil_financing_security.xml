<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Users cannot modify or delete Signed loans -->
    <record id="rule_loan_application_user_write" model="ir.rule">
        <field name="name">Loan Application User - No Signed Write</field>
        <field name="model_id" ref="model_loan_application"/>
        <field name="groups" eval="[Command.link(ref('group_financing_user'))]"/>
        <field name="domain_force">[('state', 'not in', ['signed'])]</field>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_loan_application_user_unlink" model="ir.rule">
        <field name="name">Loan Application User - No Signed Delete</field>
        <field name="model_id" ref="model_loan_application"/>
        <field name="groups" eval="[Command.link(ref('group_financing_user'))]"/>
        <field name="domain_force">[('state', 'not in', ['signed'])]</field>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- Admin bypasses the User restriction -->
    <record id="rule_loan_application_admin_write" model="ir.rule">
        <field name="name">Loan Application Admin - Full Write</field>
        <field name="model_id" ref="model_loan_application"/>
        <field name="groups" eval="[Command.link(ref('group_financing_admin'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_loan_application_admin_unlink" model="ir.rule">
        <field name="name">Loan Application Admin - Full Delete</field>
        <field name="model_id" ref="model_loan_application"/>
        <field name="groups" eval="[Command.link(ref('group_financing_admin'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="True"/>
    </record>

</odoo>