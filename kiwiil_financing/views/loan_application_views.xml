<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Loan Application List View -->
    <record id="view_loan_application_list" model="ir.ui.view">
        <field name="name">loan.application.list</field>
        <field name="model">loan.application</field>
        <field name="arch" type="xml">
            <list string="Loan Applications">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="loan_amount"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <!-- Loan Application Form View -->
    <record id="view_loan_application_form" model="ir.ui.view">
        <field name="name">loan.application.form</field>
        <field name="model">loan.application</field>
        <field name="arch" type="xml">
            <form string="Loan Application">

                <!-- Loan Status -->
                <header>
                    <field name="state" widget="statusbar"/>
                </header>

                <sheet>

                    <!-- Two-Column Layout -->
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="partner_id"/>
                            <field name="product_id"/>
                            <field name="user_id"/>
                        </group>

                        <group>
                            <field name="date_applied"/>
                            <field name="loan_term"/>
                            <field name="interest_rate"/>
                            <field name="currency_id"/>
                            <field name="loan_amount"/>
                            <field name="down_payment"/>
                        </group>
                    </group>

                    <notebook>

                        <!-- Compliance Checklist -->
                        <page string="Compliance Checklist">
                            <field name="document_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="type_id"/>
                                    <field name="state"/>
                                    <field name="attachment_id"/>
                                </list>
                            </field>
                        </page>

                        <!-- Tags -->
                        <page string="Tags">
                            <field name="tag_ids" widget="many2many_tags"/>
                        </page>

                        <!-- Internal Notes -->
                        <page string="Notes">
                            <field name="notes"/>
                        </page>

                    </notebook>

                </sheet>

            </form>
        </field>
    </record>

    <!-- Loan Application Search View -->
    <record id="view_loan_application_search" model="ir.ui.view">
        <field name="name">loan.application.search</field>
        <field name="model">loan.application</field>
        <field name="arch" type="xml">
            <search string="Loan Applications">

                <!-- Search by Customer -->
                <field name="partner_id"/>

                <!-- Filters -->
                <filter
                    name="filter_archived"
                    string="Archived"
                    domain="[('active', '=', False)]"
                />

                <filter
                    name="filter_draft"
                    string="Draft"
                    domain="[('state', '=', 'draft')]"
                />

                <filter
                    name="filter_approved"
                    string="Approved"
                    domain="[('state', '=', 'approved')]"
                />

                <separator/>

                <!-- Group By -->
                <filter
                    name="group_by_state"
                    string="State"
                    context="{'group_by': 'state'}"
                />

                <filter
                    name="group_by_partner"
                    string="Customer"
                    context="{'group_by': 'partner_id'}"
                />

            </search>
        </field>
    </record>

    <!-- Loan Application Window Action -->
    <record id="action_loan_application" model="ir.actions.act_window">
        <field name="name">Loan Applications</field>
        <field name="res_model">loan.application</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_loan_application_search"/>
    </record>

</odoo>