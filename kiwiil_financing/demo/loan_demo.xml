            <field name="down_payment">20000</field>
            <field name="loan_term">36</field>
            <field name="interest_rate">11.75</field>
            <field name="date_applied" eval="(context_today() - relativedelta(months=5)).strftime('%Y-%m-%d')"/>
        </record>

        <!-- Loan 3 -->
        <record id="loan_application_demo_3" model="loan.application">
            <field name="name">LOAN/DEMO/003</field>
            <field name="partner_id" ref="base.res_partner_3"/>
