            <field name="down_payment">15000</field>
            <field name="loan_term">24</field>
            <field name="interest_rate">13.25</field>
            <field name="date_applied" eval="(context_today() - relativedelta(months=2)).strftime('%Y-%m-%d')"/>
        </record>

    </data>
</odoo>