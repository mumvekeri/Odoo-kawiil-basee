<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Loan 1 -->
        <record id="loan_application_demo_1" model="loan.application">
            <field name="name">LOAN/DEMO/001</field>
            <field name="partner_id" ref="base.res_partner_1"/>
            <field name="product_id" ref="product.product_product_4_product_template"/>
            <field name="loan_amount">150000</field>
            <field name="down_payment">30000</field>
            <field name="loan_term">36</field>
            <field name="interest_rate">12.50</field>
            <field name="date_applied">2026-08-01</field>
        </record>

        <!-- Loan 2 -->
        <record id="loan_application_demo_2" model="loan.application">
            <field name="name">LOAN/DEMO/002</field>
            <field name="partner_id" ref="base.res_partner_2"/>
